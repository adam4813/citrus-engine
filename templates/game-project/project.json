{
  "$schema": "https://citrus-engine.github.io/schemas/project.schema.json",
  "name": "@PROJECT_NAME@",
  "version": "@PROJECT_VERSION@",
  "author": "",
  "description": "@PROJECT_DESCRIPTION@",
  "engine": {
    "version": "0.2.x"
  },
  "window": {
    "title": "@WINDOW_TITLE@",
    "width": 1280,
    "height": 720,
    "fullscreen": false,
    "vsync": true
  },
  "startup_scene": "assets/scenes/main.json",
  "assets": {
    "base_path": "assets",
    "directories": [
      "fonts",
      "images",
      "textures",
      "scenes",
      "shaders"
    ]
  },
  "build": {
    "targets": [
      {
        "platform": "native",
        "configuration": "Release"
      },
      {
        "platform": "wasm",
        "configuration": "Release",
        "emscripten": {
          "initial_memory_mb": 64,
          "max_memory_mb": 128
        }
      }
    ]
  }
}
